# ---------------------------------------------------------------------------
# NOVA OBSERVATOIRE — variables d'environnement
# Copier ce fichier vers .env.local. Ne jamais committer .env.local.
# ---------------------------------------------------------------------------

# Mode démonstration (Vercel) : aucune variable n'est nécessaire.
# Les données de démonstration vivent dans src/data/demo.json et localStorage.

# Production Supabase (V2) — renseigner après avoir exécuté la migration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service : uniquement côté serveur (imports, administration, exports).
# Ne jamais exposer cette clé avec un préfixe NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Géocodage d'appoint (Base Adresse Nationale).
NEXT_PUBLIC_BAN_API_URL=https://api-adresse.data.gouv.fr/search/

# URL publique utilisée dans les liens de partage des sélections.
NEXT_PUBLIC_APP_URL=http://localhost:3000
